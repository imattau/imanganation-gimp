# GIMP sessionrc
# 
# This file takes session-specific info (that is info, you want to keep
# between two GIMP sessions).  You are not supposed to edit it manually, but
# of course you can do.  The sessionrc will be entirely rewritten every time
# you quit GIMP.  If this file isn't found, defaults are used.
#
# Imanganation workspace: Project navigator and a compact toolbox on the left,
# Context (with Script and Page Filmstrip tabs) above Layers on the right. Other
# Imanganation docks open from Windows > Imanganation; stock dialogs from
# Windows > Dockable Dialogs.

(session-info "toplevel"
    (factory-entry "gimp-empty-image-window")
    (position 200 100)
    (size 640 480))
(session-info "toplevel"
    (factory-entry "gimp-single-image-window")
    (position 0 0)
    (size 1440 900)
    (open-on-exit)
    (aux-info
        (left-docks-width "300")
        (right-docks-width "360")
        (maximized "yes"))
    (gimp-dock
        (side left)
        (book
            (current-page 0)
            (dockable "extension-panel-imanganation.py::project"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))))
    (gimp-toolbox
        (side left))
    (gimp-dock
        (side right)
        (book
            (current-page 0)
            (dockable "extension-panel-imanganation.py::inspector"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "extension-panel-imanganation.py::script"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "extension-panel-imanganation.py::filmstrip"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true"))))
        (book
            (position 520)
            (current-page 0)
            (dockable "gimp-layer-list"
                (tab-style automatic)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true"))))))

(hide-docks no)
(single-window-mode yes)
(tabs-position 0)
(last-tip-shown 0)

# end of sessionrc
